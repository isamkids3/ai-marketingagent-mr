# Project Setup
PROJECT_NAME="Millenium Radius API"
API_V1_STR="/api/v1"

# Database Configuration (Match to Docker setup)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_dev_password_here
POSTGRES_DB=millenium_radius
POSTGRES_PORT=5432

# Connection String (postgresql+asyncpg://[user]:[password]@[host]:[port]/[db_name])
DATABASE_URL=postgresql+asyncpg://postgres:your_secure_dev_password_here@localhost:5432/millenium_radius

# Security and Authentication
# You can generate a secure secret key using: openssl rand -hex 32
SECRET_KEY=your-super-secret-key-change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=11520 # 8 days

# OpenAI / Qwen LLM Agent Configuration
OPENAI_API_KEY=your_openai_or_qwen_api_key_here
OPENAI_MODEL=gpt-4o
# Set base URL if using local LLM server or proxy (optional)
# OPENAI_API_BASE=http://localhost:8000/v1

# Tavily Search API Key
TAVILY_API_KEY=your_tavily_search_api_key_here

# ComfyUI Connection URL
COMFYUI_URL=http://localhost:8188
# SHARED_WORKSPACE_ROOT=/path/to/gen-content
